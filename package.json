{
  "name": "boards-prototype-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/geist": "^5.2.8",
    "@mondaydotcomorg/icons": "1.51.0",
    "@mondaydotcomorg/monday-ui-components": "^0.81.1",
    "@vibe/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "puppeteer": "^25.3.0",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "6.4.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,json}\"",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && eslint src && prettier --check \"src/**/*.{ts,tsx,css,scss,json}\"",
    "export:loader-gif": "node scripts/export-loader-gif.mjs",
    "export:loader-mp4": "LOADER_EXPORT_FORMAT=mp4 node scripts/export-loader-gif.mjs",
    "export:loaders": "LOADER_EXPORT_FORMAT=both node scripts/export-loader-gif.mjs"
  }
}
